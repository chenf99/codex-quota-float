#!/usr/bin/env zsh
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
INSTALL_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CONFIG_DIR="${CODEX_QUOTA_CONFIG_DIR:-$HOME/.codex-quota-float}"
CONFIG_FILE="$CONFIG_DIR/config.env"
TELEMETRY_BASE_URL="${CODEX_QUOTA_TELEMETRY_BASE_URL:-https://countapi.mileshilliard.com/api/v1}"
TELEMETRY_KEY_PREFIX="${CODEX_QUOTA_TELEMETRY_KEY_PREFIX:-chenf99-codex-quota-float}"
TELEMETRY_DISABLED_FILE="$CONFIG_DIR/telemetry.disabled"
AUTO_UPDATE_DISABLED_FILE="$CONFIG_DIR/auto-update.disabled"
AUTO_UPDATE_STATE_FILE="$CONFIG_DIR/auto-update.state"
AUTO_UPDATE_PLIST="$HOME/Library/LaunchAgents/local.codex-quota-float.auto-update.plist"
AUTO_UPDATE_LABEL="local.codex-quota-float.auto-update"
AUTO_UPDATE_REF="${CODEX_QUOTA_REF:-main}"
APP_ROOT="$INSTALL_ROOT/dist/Codex Quota Float.app"
APP_LAUNCHER="$APP_ROOT/Contents/MacOS/codex-quota-float"
APP_BIN="$APP_ROOT/Contents/MacOS/codex-quota-float-bin"

print_usage() {
  cat <<'USAGE'
Usage: codex-quota-float <command> [args]

Commands:
  start [--interval seconds] [--normal-window]
      Open the floating window. Builds the local app bundle if needed.

  stop
      Quit the floating window started from this install.

  restart [--interval seconds] [--normal-window]
      Quit and reopen the floating window.

  status [--pretty|--json]
      Print a one-shot quota summary from the local Codex app-server.

  skin set <image-path> [skin-title]
      Copy a local image into user config and use it as the image skin.

  skin reset
      Return to the built-in Classic Glass skin.

  skin path
      Show the user-local skin config path.

  autostart install
      Start Codex Quota Float automatically after macOS user login.
      Writes ~/Library/LaunchAgents/local.codex-quota-float.plist.

  autostart uninstall
      Remove the macOS autostart LaunchAgent.

  cli install [target-directory-or-path]
      Install a codex-quota-float command that works from any directory.

  update
      Update the standalone CLI install from the public repository.

  auto-update status
      Show whether automatic updates are enabled and the last check result.

  auto-update check
      Check GitHub now. Updates and restarts the window only when needed.

  auto-update enable
      Check for updates automatically every 6 hours.

  auto-update disable
      Turn off automatic update checks.

  path
      Print this install path.

Compatibility aliases:
  open                Same as start.
  quit                Same as stop.
  upgrade             Same as update.
  login install       Same as autostart install.
  login uninstall     Same as autostart uninstall.
USAGE
}

telemetry_disabled() {
  case "${CODEX_QUOTA_TELEMETRY:-}" in
    0|false|FALSE|off|OFF|no|NO)
      return 0
      ;;
  esac

  [[ -f "$TELEMETRY_DISABLED_FILE" ]]
}

telemetry_key() {
  local event="$1"
  echo "${TELEMETRY_KEY_PREFIX}-${event}"
}

telemetry_url() {
  local action="$1"
  local event="$2"
  echo "${TELEMETRY_BASE_URL%/}/$action/$(telemetry_key "$event")"
}

counter_value() {
  local event="$1"
  local json value

  if ! command -v curl >/dev/null 2>&1; then
    echo "unavailable"
    return 0
  fi

  json="$(curl -sS --max-time 5 "$(telemetry_url get "$event")" 2>/dev/null || true)"

  if [[ "$json" == *'"error":"Key not found"'* ]]; then
    echo "0"
    return 0
  fi

  value="${json#*\"value\":}"

  if [[ "$value" == "$json" ]]; then
    echo "unavailable"
    return 0
  fi

  value="${value%%[^0-9]*}"
  if [[ -z "$value" ]]; then
    echo "unavailable"
    return 0
  fi

  echo "$value"
}

print_stats() {
  cat <<EOF
Codex Quota Float stats
  Anonymous installs: $(counter_value install)

Counter endpoint:
  $(telemetry_url get install)
EOF
}

print_telemetry_status() {
  if telemetry_disabled; then
    echo "Anonymous install counting: disabled"
  else
    echo "Anonymous install counting: enabled"
  fi

  echo "Counter key: $(telemetry_key install)"
  echo "Counter endpoint: $(telemetry_url get install)"
}

stop_window() {
  local stopped=0

  if [[ -e "$APP_BIN" ]]; then
    if pkill -f "$APP_BIN" 2>/dev/null; then
      stopped=1
    fi
  fi

  if [[ -e "$APP_LAUNCHER" ]]; then
    if pkill -f "$APP_LAUNCHER" 2>/dev/null; then
      stopped=1
    fi
  fi

  if [[ "$stopped" == "1" ]]; then
    echo "Stopped Codex Quota Float."
  else
    echo "Codex Quota Float is not running from this install."
  fi
}

short_revision() {
  local revision="${1:-}"
  if [[ -z "$revision" || "$revision" == "unknown" ]]; then
    echo "unknown"
    return 0
  fi
  echo "${revision[1,7]}"
}

current_revision() {
  local revision=""
  if command -v git >/dev/null 2>&1 && [[ -d "$INSTALL_ROOT/.git" ]]; then
    revision="$(git -C "$INSTALL_ROOT" rev-parse HEAD 2>/dev/null || true)"
  fi
  if [[ -z "$revision" && -f "$CONFIG_DIR/installed-revision" ]]; then
    revision="$(<"$CONFIG_DIR/installed-revision")"
  fi
  echo "${revision:-unknown}"
}

remote_revision() {
  if ! command -v git >/dev/null 2>&1; then
    return 1
  fi

  local remote_url="${CODEX_QUOTA_REPO_URL:-}"
  if [[ -z "$remote_url" && -d "$INSTALL_ROOT/.git" ]]; then
    remote_url="$(git -C "$INSTALL_ROOT" remote get-url origin 2>/dev/null || true)"
  fi
  remote_url="${remote_url:-https://github.com/chenf99/codex-quota-float.git}"

  git ls-remote "$remote_url" "refs/heads/$AUTO_UPDATE_REF" 2>/dev/null | awk 'NR == 1 { print $1 }'
}

write_auto_update_state() {
  local result="$1"
  local current="$2"
  local latest="$3"
  local message="$4"
  local tmp

  mkdir -p "$CONFIG_DIR"
  tmp="$AUTO_UPDATE_STATE_FILE.tmp.$$"
  {
    echo "checked_at=$(date '+%Y-%m-%d %H:%M:%S %z')"
    echo "result=$result"
    echo "current_revision=$current"
    echo "latest_revision=$latest"
    echo "message=$message"
  } >"$tmp"
  mv "$tmp" "$AUTO_UPDATE_STATE_FILE"
}

auto_update_check() {
  local current latest was_running=0
  current="$(current_revision)"

  if ! latest="$(remote_revision)" || [[ -z "$latest" ]]; then
    write_auto_update_state "failed" "$current" "unknown" "Could not read the latest revision from GitHub."
    echo "Automatic update check failed: could not reach GitHub." >&2
    return 1
  fi

  if [[ "$current" == "$latest" ]]; then
    write_auto_update_state "up-to-date" "$current" "$latest" "Already up to date."
    echo "Codex Quota Float is up to date ($(short_revision "$current"))."
    return 0
  fi

  if pgrep -f "$APP_BIN" >/dev/null 2>&1 || pgrep -f "$APP_LAUNCHER" >/dev/null 2>&1; then
    was_running=1
  fi

  write_auto_update_state "updating" "$current" "$latest" "Installing the latest revision."
  echo "Updating Codex Quota Float: $(short_revision "$current") -> $(short_revision "$latest")"

  if ! CODEX_QUOTA_SKIP_AUTO_UPDATE_AGENT=1 \
    CODEX_QUOTA_INSTALL_DIR="$INSTALL_ROOT" \
    CODEX_QUOTA_CONFIG_DIR="$CONFIG_DIR" \
    CODEX_QUOTA_REF="$AUTO_UPDATE_REF" \
    "$INSTALL_ROOT/install.sh"; then
    write_auto_update_state "failed" "$current" "$latest" "Installer failed."
    echo "Automatic update failed while running the installer." >&2
    return 1
  fi

  local installed
  installed="$(current_revision)"
  if [[ "$installed" != "$latest" ]]; then
    write_auto_update_state "failed" "$installed" "$latest" "Installed revision did not match GitHub."
    echo "Automatic update did not install the expected revision." >&2
    return 1
  fi

  if [[ "$was_running" == "1" ]]; then
    "$INSTALL_ROOT/scripts/codex-quota-float" restart
  fi

  write_auto_update_state "updated" "$installed" "$latest" "Updated successfully."
  echo "Automatic update completed ($(short_revision "$installed"))."
}

print_auto_update_status() {
  local enabled="enabled"
  if [[ -f "$AUTO_UPDATE_DISABLED_FILE" ]]; then
    enabled="disabled"
  elif [[ ! -f "$AUTO_UPDATE_PLIST" ]]; then
    enabled="not installed"
  elif ! launchctl print "gui/$(id -u)/$AUTO_UPDATE_LABEL" >/dev/null 2>&1; then
    enabled="enabled, but the background agent is not loaded"
  fi

  echo "Automatic updates: $enabled"
  echo "Check interval: every 6 hours"
  if [[ -f "$AUTO_UPDATE_STATE_FILE" ]]; then
    while IFS='=' read -r key value; do
      case "$key" in
        checked_at) echo "Last check: $value" ;;
        result) echo "Last result: $value" ;;
        message) echo "Details: $value" ;;
      esac
    done <"$AUTO_UPDATE_STATE_FILE"
  else
    echo "Last check: never"
  fi
  echo "Current revision: $(short_revision "$(current_revision)")"
}

command="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$command" in
  help|--help|-h)
    print_usage
    ;;
  start|open)
    exec "$SCRIPT_DIR/open_float.sh" "$@"
    ;;
  run)
    exec "$SCRIPT_DIR/run_float.sh" "$@"
    ;;
  stop|quit)
    stop_window
    ;;
  restart)
    stop_window
    exec "$SCRIPT_DIR/open_float.sh" "$@"
    ;;
  status)
    exec "$SCRIPT_DIR/codex_quota_status.py" "$@"
    ;;
  stats)
    print_stats
    ;;
  telemetry)
    subcommand="${1:-status}"
    if [[ $# -gt 0 ]]; then
      shift
    fi
    case "$subcommand" in
      status)
        print_telemetry_status
        ;;
      disable)
        mkdir -p "$CONFIG_DIR"
        : >"$TELEMETRY_DISABLED_FILE"
        echo "Anonymous install counting is disabled on this machine."
        ;;
      enable)
        rm -f "$TELEMETRY_DISABLED_FILE"
        echo "Anonymous install counting is enabled on this machine."
        ;;
      help|--help|-h)
        cat <<'USAGE'
Usage: codex-quota-float telemetry <command>

Commands:
  status    Show anonymous install counting status and endpoint.
  disable   Disable anonymous install counting on this machine.
  enable    Enable anonymous install counting on this machine.
USAGE
        ;;
      *)
        echo "Unknown telemetry command: $subcommand" >&2
        echo "Run 'codex-quota-float telemetry help' for usage." >&2
        exit 2
        ;;
    esac
    ;;
  update|upgrade)
    INSTALLER="$INSTALL_ROOT/install.sh"
    if [[ -x "$INSTALLER" ]]; then
      exec "$INSTALLER" "$@"
    fi
    echo "This install does not include install.sh." >&2
    echo "Update with:" >&2
    echo '  curl -fsSL "https://raw.githubusercontent.com/chenf99/codex-quota-float/main/install.sh?$(date +%s)" | zsh' >&2
    exit 1
    ;;
  auto-update)
    subcommand="${1:-status}"
    if [[ $# -gt 0 ]]; then
      shift
    fi
    case "$subcommand" in
      status)
        print_auto_update_status
        ;;
      check|now)
        auto_update_check
        ;;
      enable)
        mkdir -p "$CONFIG_DIR"
        rm -f "$AUTO_UPDATE_DISABLED_FILE"
        exec "$SCRIPT_DIR/install_auto_update_agent.sh" "$@"
        ;;
      disable)
        mkdir -p "$CONFIG_DIR"
        : >"$AUTO_UPDATE_DISABLED_FILE"
        exec "$SCRIPT_DIR/uninstall_auto_update_agent.sh" "$@"
        ;;
      help|--help|-h)
        cat <<'USAGE'
Usage: codex-quota-float auto-update <command>

Commands:
  status    Show automatic update status and the last check result.
  check     Check GitHub now and install a newer version if available.
  enable    Enable background update checks every 6 hours.
  disable   Disable background update checks.
USAGE
        ;;
      *)
        echo "Unknown auto-update command: $subcommand" >&2
        echo "Run 'codex-quota-float auto-update help' for usage." >&2
        exit 2
        ;;
    esac
    ;;
  skin)
    subcommand="${1:-help}"
    if [[ $# -gt 0 ]]; then
      shift
    fi
    case "$subcommand" in
      set)
        exec "$SCRIPT_DIR/set_image_skin.sh" "$@"
        ;;
      reset)
        rm -f "$CONFIG_FILE"
        echo "Reset skin to Classic Glass."
        echo "Removed $CONFIG_FILE"
        ;;
      path)
        echo "Config directory: $CONFIG_DIR"
        echo "Config file: $CONFIG_FILE"
        if [[ -f "$CONFIG_FILE" ]]; then
          echo
          sed 's/^/  /' "$CONFIG_FILE"
        else
          echo "No custom skin is configured."
        fi
        ;;
      help|--help|-h)
        cat <<'USAGE'
Usage: codex-quota-float skin <command> [args]

Commands:
  set <image-path> [skin-title]   Configure a local image skin.
  reset                           Return to Classic Glass.
  path                            Show the user-local config path.
USAGE
        ;;
      *)
        echo "Unknown skin command: $subcommand" >&2
        echo "Run 'codex-quota-float skin help' for usage." >&2
        exit 2
        ;;
    esac
    ;;
  autostart|login)
    parent_command="$command"
    subcommand="${1:-help}"
    if [[ $# -gt 0 ]]; then
      shift
    fi
    case "$subcommand" in
      install)
        exec "$SCRIPT_DIR/install_launch_agent.sh" "$@"
        ;;
      uninstall|remove)
        exec "$SCRIPT_DIR/uninstall_launch_agent.sh" "$@"
        ;;
      help|--help|-h)
        cat <<'USAGE'
Usage: codex-quota-float autostart <command>

Commands:
  install     Create a per-user macOS LaunchAgent and start it now.
  uninstall   Remove the LaunchAgent so the app no longer starts at login.

Compatibility:
  codex-quota-float login install
  codex-quota-float login uninstall
USAGE
        ;;
      *)
        echo "Unknown $parent_command command: $subcommand" >&2
        echo "Run 'codex-quota-float autostart help' for usage." >&2
        exit 2
        ;;
    esac
    ;;
  cli)
    subcommand="${1:-help}"
    if [[ $# -gt 0 ]]; then
      shift
    fi
    case "$subcommand" in
      install)
        exec "$SCRIPT_DIR/install_cli.sh" "$@"
        ;;
      help|--help|-h)
        cat <<'USAGE'
Usage: codex-quota-float cli <command> [args]

Commands:
  install [target-directory-or-path]   Install the CLI wrapper.
USAGE
        ;;
      *)
        echo "Unknown cli command: $subcommand" >&2
        echo "Run 'codex-quota-float cli help' for usage." >&2
        exit 2
        ;;
    esac
    ;;
  path)
    echo "$INSTALL_ROOT"
    ;;
  *)
    echo "Unknown command: $command" >&2
    echo "Run 'codex-quota-float help' for usage." >&2
    exit 2
    ;;
esac
